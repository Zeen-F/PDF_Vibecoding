{
  "name": "paperdesk",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "start": "node server/index.mjs",
    "test": "npm run test:api",
    "test:api": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "check": "npm run test:api && npm run build && npm run test:browser",
    "predev": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "lucide-react": "^0.577.0",
    "multer": "2.4.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.2"
  }
}
