{
  "name": "paperdesk",
  "version": "1.2.0-alpha.5",
  "description": "A local PDF reading, annotation and notes workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "start": "node server/index.mjs",
    "test": "npm run test:api",
    "test:api": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "check": "npm run test:api && npm run build && npm run test:browser",
    "predev": "node scripts/prepare-assets.mjs",
    "plugin:setup": "node scripts/setup-plugin.mjs",
    "plugin:install": "node scripts/setup-plugin.mjs --install",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && node scripts/prepare-desktop-assets.mjs && electron-builder --config electron-builder.config.cjs --dir --mac --arm64 --publish never",
    "desktop:dist": "npm run build && node scripts/prepare-desktop-assets.mjs && electron-builder --config electron-builder.config.cjs --mac dmg zip --arm64 --publish never",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:desktop:reliability": "node tests/desktop-reliability.mjs",
    "release:checksums": "node scripts/release-checksums.mjs",
    "browser:dist": "npm run build && node scripts/package-browser.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/canvas": "1.0.10",
    "express": "5.2.1",
    "lucide-react": "^0.577.0",
    "multer": "2.4.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.2"
  }
}
